{
  "name": "ocg-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "pnpm contracts:check && tsc --noEmit && rsbuild build",
    "start": "rsbuild preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "contracts": "cargo run --locked --quiet --bin ocg-rs-ts",
    "contracts:check": "cargo run --locked --quiet --bin ocg-rs-ts -- --check"
  },
  "dependencies": {
    "@crafter/mermaid": "^0.0.3",
    "@lucide/solid": "1.81.0",
    "@solidjs/web": "2.0.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "parse-diff": "^0.14.0",
    "solid-js": "2.0.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@rsbuild/core": "2.3.5",
    "@rsbuild/plugin-solid": "2.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
